# Postgres (Neon via Vercel Marketplace) — added automatically when you connect Neon in Vercel
DATABASE_URL=

# Private Vercel Blob store — added automatically when you create a Blob store in Vercel
BLOB_READ_WRITE_TOKEN=


# Public brand name (standalone; no ties to any other organization)
NEXT_PUBLIC_SITE_NAME=

# Email confirmations (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Text confirmations (RingCentral, JWT app)
RC_SERVER_URL=https://platform.ringcentral.com
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
RC_FROM_NUMBER=

# Rep sign-in (Auth.js + Microsoft Entra ID, single-tenant)
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<Directory (tenant) ID>/v2.0/
# Comma-separated Microsoft 365 emails that become admins on first sign-in
REP_ADMIN_EMAILS=

# AI assist (reps only)
ANTHROPIC_API_KEY=
